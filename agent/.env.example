# ---- 复制到项目根目录 .env，按需修改；.env 不提交仓库 ----

# 模型提供器：ollama（默认自托管）| deepseek（默认关闭，需人工开启）
#
# 注意：前端顶栏可以填用户自己的 DeepSeek 密钥，那条路优先级更高——
# 填了就以它为准，留空才回落到这里配置的提供器。这里的 DEEPSEEK_API_KEY
# 是给脚本/接口调用用的，不填也不影响前端那条路。
LLM_PROVIDER=ollama

# Ollama 本地模型
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.5:4b
EMBED_MODEL=bge-m3

# 生成参数：关闭思考、限制上下文与输出
LLM_THINK=false
LLM_NUM_CTX=4096
LLM_NUM_PREDICT=260
LLM_TEMPERATURE=0.8
LLM_KEEP_ALIVE=30m

# Milvus
MILVUS_URI=http://127.0.0.1:19530
MILVUS_TOKEN=root:Milvus
MILVUS_COLLECTION=four_classics_chunks
RAG_BOOK=红楼梦
RAG_TOP_K=4
RAG_MIN_SCORE=0.42

# MySQL
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DB=daiyu_agent

# 会话与记忆
DEFAULT_USER_ID=local_default
SHORT_TERM_TURNS=6
LONG_TERM_LIMIT=40

# 房间小关目：进门时引出"没经历过的"一桩的概率（谈话中的回望按 0.4 倍计）
VIGNETTE_CHANCE=0.35

# 服务
AGENT_HOST=127.0.0.1
AGENT_PORT=8000
AGENT_CORS_ORIGINS=*

# DeepSeek（仅当 LLM_PROVIDER=deepseek 时读取）
# DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# DEEPSEEK_MODEL=deepseek-chat
